---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CTABand from '../components/CTABand.astro';
import WindField from '../components/WindField.astro';
import { STATS } from '../data/site';

// Hero aside. `from` is a nowrap mono label in a 9rem column: keep it under ~18 characters.
const BRIDGE = [
  { from: 'Public chatbots', to: 'A private assistant' },
  { from: 'Hosted model APIs', to: 'Weights you hold' },
  { from: 'Model deprecations', to: 'Versions you retire' },
  { from: 'Vendor telemetry', to: 'No outbound traffic' },
  { from: 'Data sent abroad', to: 'Data kept in-country' },
];

const EXPOSURE: { num: string; title: string; desc: string; fns: string[] }[] = [
  {
    num: '01',
    title: 'Your staff already use AI tools you never approved.',
    desc: 'In IBM’s 2025 study, one in five breached organizations reported a breach involving shadow AI, and heavy users paid about US$670,000 more per breach. A ban fails if staff have nothing approved to use.',
    fns: ['a'],
  },
  {
    num: '02',
    title: 'Storing data in a region doesn’t decide who can reach it.',
    desc: 'Under the CLOUD Act, a US provider must hand over data it controls, wherever it sits. In 2025, Microsoft France told the French Senate under oath that it couldn’t rule this out for French public-sector data, though it had never happened.',
    fns: ['b', 'c'],
  },
  {
    num: '03',
    title: 'The model you validated retires on someone else’s schedule.',
    desc: 'Microsoft retires a hosted model version 18 months after launch, with no extensions. Google’s long-term Gemini models get at least 12 months. Each retirement means validating your workflows again. Hold the weights and you choose when the model changes.',
    fns: ['d'],
  },
  {
    num: '04',
    title: 'An air gap breaks every install script.',
    desc: 'Installing the vLLM inference server pulls in 196 Python packages, 27 of them from NVIDIA. Behind an air gap, someone mirrors, scans, approves, and carries across each one, at every update.',
    fns: ['e'],
  },
  {
    num: '05',
    title: 'The rules keep asking where the data is.',
    desc: 'DORA makes EU financial firms manage their reliance on cloud providers. NERC rules keep US bulk-power systems largely off the public cloud. India requires payment data to be stored in India.',
    fns: ['f', 'g', 'h'],
  },
];

// Least to most isolated. `level` drives a decorative four-segment gauge.
const TIERS: {
  level: number;
  name: string;
  desc: string;
  protects: string;
  tradeoff: string;
  fit: string;
  fns?: string[];
}[] = [
  {
    level: 1,
    name: 'Hosted API',
    desc: 'A frontier model under an enterprise contract.',
    protects: 'Retention, and training on your data.',
    tradeoff: 'Their jurisdiction and their retirement schedule.',
    fit: 'Most everyday work',
  },
  {
    level: 2,
    name: 'Sovereign cloud',
    desc: 'Dedicated capacity in your region, sometimes run by a local operator.',
    protects: 'Data leaving the region.',
    tradeoff: 'Still networked, and you don’t hold the weights.',
    fit: 'In-region mandates',
  },
  {
    level: 3,
    name: 'Self-hosted',
    desc: 'Open-weight models on your hardware, with outbound traffic blocked.',
    protects: 'Data leaving, forced upgrades, and foreign legal process.',
    tradeoff: 'You run the GPUs, and open models still trail the best closed ones.',
    fit: 'Sensitive data, validated workflows',
    fns: ['i'],
  },
  {
    level: 4,
    name: 'Air-gapped',
    desc: 'No network path at all. Updates cross on approved media.',
    protects: 'Everything above, plus attacks over the network.',
    tradeoff: 'Every update becomes a procedure.',
    fit: 'Plant floors, isolated labs, trade secrets',
  },
];

const TRANSFERS: { have: string; apply: string; fns?: string[] }[] = [
  {
    have: 'Federated training across 71 sites on six continents',
    apply: 'One model trained across countries or partners, each dataset kept where the law requires.',
    fns: ['3'],
  },
  {
    have: 'Inference tuned for limited clinical hardware',
    apply: 'A useful model on GPUs you can actually buy and run on-site.',
    fns: ['4', 'j'],
  },
  {
    have: 'Reproducible builds and maintained conda-forge packages',
    apply: 'Every dependency pinned and mirrored, so the stack rebuilds offline.',
  },
];

const SERVICES = [
  {
    num: '01',
    title: 'Readiness & architecture sprint',
    desc: 'Every workload placed on a tier, with hardware sized and a build-or-buy call.',
  },
  {
    num: '02',
    title: 'Data engineering inside the perimeter',
    desc: 'Pipelines and search indexes built where the data lives, never copied out.',
  },
  {
    num: '03',
    title: 'Model selection & evaluation',
    desc: 'Open-weight models tuned on your data and tested on cases you write.',
  },
  {
    num: '04',
    title: 'Air-gapped deployment & MLOps',
    desc: 'Mirrored registries, a written transfer procedure, and monitoring that sends nothing out.',
  },
  {
    num: '05',
    title: 'Governance & documentation',
    desc: 'Data-flow maps and validation files, written for your assessor.',
  },
  {
    num: '06',
    title: 'Fractional AI leadership',
    desc: 'A senior AI lead a few days a month, testing every vendor’s “sovereign” claim.',
  },
];

// Copy is tuned to ~2 lines of `desc`; the card reserves that height so dividers line up.
const MODELS = [
  {
    title: 'Readiness sprint',
    desc: 'Two to four weeks at a fixed fee, covering every workload you’re weighing.',
    outcome: 'A costed plan your security office has already read.',
  },
  {
    title: 'Private assistant pilot',
    desc: 'One team and one document set, on an open-weight model running on your hardware.',
    outcome: 'A visible win, and an offline stack you keep.',
  },
  {
    title: 'Stalled-pilot rescue',
    desc: 'For a pilot stuck at security review. We close the findings and rebuild what can’t pass.',
    outcome: 'The pilot back in front of the reviewers.',
  },
];
---

<Base
  title="Air-Gapped & Sovereign AI"
  description="Vaiyu Solutions builds AI that runs on infrastructure you control: open-weight models on your hardware, air-gapped deployment, and private assistants for regulated teams."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <WindField class="text-ink" />
    <div class="relative mx-auto grid max-w-6xl gap-12 px-5 pb-16 pt-20 md:pb-24 md:pt-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Eyebrow label="For air-gapped & sovereign deployments" class="reveal" />
        <h1 class="h-display mt-5 text-[2.6rem] md:text-6xl reveal reveal-2">
          Your data stays put. The model <em>comes to it</em>.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft reveal reveal-3">
          Most AI tools assume they can reach the internet. On an air-gapped network they can’t, and a
          residency rule may forbid it. We build AI that runs entirely on infrastructure you control,
          and we’ll tell you which workloads don’t need that. We learned how in hospitals.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 reveal reveal-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-3 bg-ink px-7 py-3.5 text-paper transition-colors hover:bg-saffron"
          >
            <span class="label-mono">Start a conversation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/work/" class="link-ink label-mono text-ink-soft">See the track record</a>
        </div>
      </div>
      <aside class="self-center lg:col-span-5 reveal reveal-5">
        <div class="border border-ink/15 bg-paper/80 p-7">
          <p class="label-mono text-slate">For workloads that can’t leave</p>
          <ul class="mt-4 divide-y divide-ink/10">
            {
              BRIDGE.map((b) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 sm:flex-nowrap">
                  <span class="w-full shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-widest text-slate sm:w-36">
                    {b.from}
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-saffron">→</span>
                  <span class="font-display text-lg">{b.to}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- Proof bar -->
  <section aria-label="Track record" class="border-y border-ink/10 bg-cream">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-12 md:grid-cols-5">
      {
        STATS.map((s) => (
          <div>
            <p class="font-display text-4xl leading-none md:text-[2.6rem]">
              {s.prefix && (
                <span class="mr-1 align-middle font-mono text-[11px] uppercase tracking-widest text-slate">
                  {s.prefix}
                </span>
              )}
              {s.value}
              {s.fn && (
                <sup class="fn">
                  <a href={`#fn-${s.fn}`} aria-label={`Footnote ${s.fn}`}>
                    {s.fn}
                  </a>
                </sup>
              )}
            </p>
            <p class="mt-3 font-mono text-[11px] uppercase leading-relaxed tracking-[0.16em] text-slate">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The exposure -->
  <section class="relative border-t border-ink/10">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="01" label="The exposure" />
      <h2 class="h-display mt-4 max-w-3xl text-3xl md:text-4xl">
        Every default in the AI stack assumes your data can leave.
      </h2>
      <ul class="mt-12 divide-y divide-ink/10 border-y border-ink/10">
        {
          EXPOSURE.map((b) => (
            <li class="group grid gap-x-8 gap-y-2 py-7 md:grid-cols-[4rem_1fr]">
              <span class="font-mono text-[11px] text-slate transition-colors group-hover:text-saffron">
                {b.num}
              </span>
              <div>
                <h3 class="font-display text-xl leading-snug transition-colors group-hover:text-saffron">
                  {b.title}
                </h3>
                <p class="mt-2.5 max-w-3xl leading-relaxed text-ink-soft">
                  {b.desc}
                  <sup class="fn">
                    {b.fns.map((f, i) => (
                      <Fragment>
                        {i > 0 && <span aria-hidden="true">,</span>}
                        <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                          {f}
                        </a>
                      </Fragment>
                    ))}
                  </sup>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The spectrum -->
  <section class="relative border-t border-ink/10 bg-cream">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="02" label="The spectrum" />
      <h2 class="h-display mt-4 max-w-3xl text-3xl md:text-4xl">
        <span class="inline-block">Sovereignty is a spectrum.</span>
        <span class="inline-block">An air gap is the far end of it.</span>
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        Most teams we work with need two: one for everyday work, and a stricter one for the workloads
        that carry real risk.
      </p>
      <p class="label-mono mt-12 text-slate">Ordered by isolation, least to most</p>
      <ol class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
        {
          TIERS.map((t) => (
            <li class="group grid gap-x-10 gap-y-4 py-7 md:grid-cols-[14rem_1fr] lg:grid-cols-[15rem_1fr_12rem]">
              <div>
                <p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-slate">
                  <span>
                    Tier {t.level}
                    <span class="sr-only"> of 4</span>
                  </span>
                  <span aria-hidden="true" class="flex gap-1">
                    {[1, 2, 3, 4].map((n) => (
                      <span class:list={['block h-0.5 w-4', n <= t.level ? 'bg-ink/80' : 'bg-ink/15']} />
                    ))}
                  </span>
                </p>
                <h3 class="font-display mt-2.5 text-xl leading-snug transition-colors group-hover:text-saffron">
                  {t.name}
                </h3>
              </div>
              <div>
                <p class="max-w-2xl leading-relaxed text-ink-soft">{t.desc}</p>
                <dl class="mt-4 grid max-w-2xl gap-x-5 gap-y-2 text-sm leading-relaxed sm:grid-cols-[7.5rem_1fr]">
                  <dt class="font-mono text-[11px] uppercase leading-[1.625rem] tracking-[0.14em] text-slate sm:leading-[1.4rem]">
                    Guards against
                  </dt>
                  <dd class="text-ink-soft">{t.protects}</dd>
                  <dt class="mt-2 font-mono text-[11px] uppercase leading-[1.625rem] tracking-[0.14em] text-slate sm:mt-0 sm:leading-[1.4rem]">
                    Trade-off
                  </dt>
                  <dd class="text-ink-soft">
                    {t.tradeoff}
                    {t.fns && (
                      <sup class="fn">
                        <a href={`#fn-${t.fns[0]}`} aria-label={`Footnote ${t.fns[0]}`}>
                          {t.fns[0]}
                        </a>
                      </sup>
                    )}
                  </dd>
                </dl>
              </div>
              <div class="md:col-start-2 lg:col-start-auto">
                <p class="label-mono text-slate">Right for</p>
                <p class="font-display mt-1.5 text-[0.95rem] italic leading-snug text-ink">{t.fit}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-12 max-w-2xl border-l-2 border-saffron pl-6 font-display text-2xl italic leading-snug text-pretty md:text-[1.75rem]">
        We will tell you which tier each workload needs, including when the answer is the cloud.
      </p>
    </div>
  </section>

  <!-- What transfers -->
  <section class="relative border-t border-ink/10">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="03" label="What transfers" />
      <h2 class="h-display mt-4 max-w-2xl text-3xl md:text-4xl">
        We learned this in hospitals, where the data can’t leave either.
      </h2>
      <ul class="mt-12 divide-y divide-ink/10 border-y border-ink/10">
        {
          TRANSFERS.map((t) => (
            <li class="group grid items-baseline gap-x-10 gap-y-2 py-5 md:grid-cols-[1fr_auto_1fr]">
              <span class="leading-relaxed text-slate">
                {t.have}
                {t.fns && (
                  <sup class="fn">
                    {t.fns.map((f, i) => (
                      <Fragment>
                        {i > 0 && <span aria-hidden="true">,</span>}
                        <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                          {f}
                        </a>
                      </Fragment>
                    ))}
                  </sup>
                )}
              </span>
              <span
                aria-hidden="true"
                class="hidden shrink-0 text-saffron transition-transform group-hover:translate-x-0.5 md:block"
              >
                →
              </span>
              <span class="font-display text-lg leading-snug transition-colors group-hover:text-saffron">
                {t.apply}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What we do -->
  <section class="relative border-t border-ink/10 bg-cream">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="04" label="What we do for sovereign deployments" />
      <h2 class="h-display mt-4 max-w-2xl text-3xl md:text-4xl">
        Six services, run inside your perimeter.
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        We don’t sell GPUs, models, or licenses. We build on what you own and hand it to your team.
      </p>
      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((s) => (
            <div class="group border-t-2 border-ink/80 pt-5 transition duration-200 hover:-translate-y-1 hover:border-saffron">
              <p class="font-mono text-[11px] text-slate transition-colors group-hover:text-saffron">{s.num}</p>
              <h3 class="font-display mt-3 text-xl transition-colors group-hover:text-saffron">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How we engage -->
  <section class="border-t border-ink/10">
    <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
      <Eyebrow num="05" label="How we engage" />
      <h2 class="h-display mt-4 max-w-2xl text-4xl md:text-5xl">
        Start with one workload, on one tier.
      </h2>
      <p class="mt-5 max-w-xl leading-relaxed text-ink-soft">
        Each engagement has its own scope, fee, and exit criteria.
      </p>
      <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          MODELS.map((m) => (
            <div class="group border-t-2 border-ink/80 pt-5 transition duration-200 hover:-translate-y-1 hover:border-saffron">
              <h3 class="font-display text-xl leading-snug transition-colors group-hover:text-saffron">
                {m.title}
              </h3>
              <p class="mt-3 min-h-[2.84rem] text-sm leading-relaxed text-ink-soft">{m.desc}</p>
              <p class="mt-4 flex items-baseline gap-2 border-t border-ink/10 pt-4">
                <span aria-hidden="true" class="shrink-0 text-saffron transition-transform group-hover:translate-x-0.5">
                  →
                </span>
                <span class="font-display text-[0.95rem] italic leading-snug text-pretty text-ink">{m.outcome}</span>
              </p>
            </div>
          ))
        }
      </div>
      <p class="mt-12 max-w-2xl border-l-2 border-ink/15 pl-6 text-sm leading-relaxed text-slate">
        We build and document the controls. Your security office and your assessor sign off on them.
      </p>
    </div>
  </section>

  <CTABand
    heading="Bring the model to the data."
    sub="Start with a readiness sprint or a one-workload pilot on your own hardware."
  />

  <!-- Footnotes -->
  <section aria-label="Sources and attribution" class="mx-auto max-w-6xl px-5 py-12">
    <p class="label-mono text-slate">Sources & attribution</p>
    <ol class="mt-4 max-w-3xl space-y-2 font-mono text-xs leading-relaxed text-slate">
      <li id="fn-1">
        1. Led by our founder across NIH/NCI-funded programs at the University of Pennsylvania and
        Indiana University.
      </li>
      <li id="fn-2">
        2. Vaiyu client engagements: pre-training optimization with model accuracy maintained or
        improved.
      </li>
      <li id="fn-3">
        3. Pati, S. et al. “Federated learning enables big data for rare cancer boundary detection.”
        Nature Communications 13 (2022). <a href="https://doi.org/10.1038/s41467-022-33407-5" class="link-ink" rel="noopener">doi:10.1038/s41467-022-33407-5</a>; 71 sites across 6 continents, the largest real-world federated learning study to date.
      </li>
      <li id="fn-4">
        4. Founder track record at Indiana University: inference latency reduced by up to 70%,
        compute requirements by 10–50%, in clinical research environments.
      </li>
      <li id="fn-a">
        a. IBM and Ponemon Institute, <em>Cost of a Data Breach Report 2025</em>: 600 breached
        organizations; 20% reported a shadow-AI breach; average cost USD 4.74M with high shadow-AI use,
        USD 4.07M with low or none.
      </li>
      <li id="fn-b">b. CLOUD Act, 18 U.S.C. § 2713: data in a provider’s “possession, custody, or control,” wherever located.</li>
      <li id="fn-c">
        c. French Senate inquiry on public procurement, Microsoft France hearing, 10 June 2025: “Non, je
        ne peux pas le garantir, mais […] cela ne s’est encore jamais produit.”
      </li>
      <li id="fn-d">
        d. Microsoft Learn, Foundry Models lifecycle policy, July 2026: retirement 18 months after
        launch (12 for some partner models), not extendable. Google Cloud, model lifecycle, September
        2026: long-term Gemini models available at least 12 months.
      </li>
      <li id="fn-e">e. Measured by Vaiyu, 23 September 2026: <code>uv pip compile</code> for vllm 0.30.0, Python 3.12, x86-64 Linux.</li>
      <li id="fn-f">f. DORA, Regulation (EU) 2022/2554, applicable 17 January 2025, Article 29. It does not require data localization.</li>
      <li id="fn-g">g. NERC Project 2023-09 white paper, December 2025: current CIP rules are “effectively prohibiting” all but basic cloud use.</li>
      <li id="fn-h">h. Reserve Bank of India circular, 6 April 2018: payment data “stored in a system only in India.”</li>
      <li id="fn-i">
        i. Stanford HAI, <em>AI Index Report 2026</em>: the top closed model led the top open model by
        3.3% on the Arena leaderboard in March 2026.
      </li>
      <li id="fn-j">
        j. Thakur, S., Pati, S. et al. Computers in Biology and Medicine 196 (2025). <a href="https://doi.org/10.1016/j.compbiomed.2025.110615" class="link-ink" rel="noopener">doi:10.1016/j.compbiomed.2025.110615</a>.
      </li>
    </ol>
  </section>
</Base>
