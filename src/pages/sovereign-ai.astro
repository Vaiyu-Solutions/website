---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import CTABand from '../components/CTABand.astro';
import WindField from '../components/WindField.astro';
import { SITE, STATS, PROJECTS, COMMUNITY } from '../data/site';

// Hero aside: what changes for the workloads that have to stay inside. The left column renders as a nowrap
// 11px mono label in a 9rem column from `sm` up (stacked above the phrase on phones), so
// keep `from` at or under ~18 characters.
const BRIDGE = [
  { from: 'Public chatbots', to: 'A private assistant' },
  { from: 'Hosted model APIs', to: 'Weights you hold' },
  { from: 'Model deprecations', to: 'Versions you retire' },
  { from: 'Vendor telemetry', to: 'No outbound traffic' },
  { from: 'Data sent abroad', to: 'Data kept in-country' },
];

// The case for the page. Every claim carries its source; `fns` index the footnotes below.
const EXPOSURE: { num: string; title: string; desc: string; fns?: string[] }[] = [
  {
    num: '01',
    title: 'Your staff already use AI tools you never approved.',
    desc: 'In IBM’s 2025 study of 600 breached organizations, one in five reported a breach involving shadow AI, meaning AI tools staff used without approval. Organizations with heavy shadow-AI use paid about US$670,000 more per breach, on average, than those with little or none. Banning public tools doesn’t work when there is nothing approved to use instead.',
    fns: ['a'],
  },
  {
    num: '02',
    title: 'Where your data is stored doesn’t decide who can reach it.',
    desc: 'Under the US CLOUD Act, a US provider must answer US legal process for data in its possession, custody, or control, wherever the data is stored. In June 2025 a French Senate inquiry asked Microsoft France’s director of public and legal affairs, under oath, whether French citizens’ data entrusted to Microsoft through public contracts could reach US authorities without French consent. “No, I cannot guarantee it,” he said, adding that it had never happened. Picking a region settles residency, not jurisdiction.',
    fns: ['b', 'c'],
  },
  {
    num: '03',
    title: 'The model you validated retires on someone else’s schedule.',
    desc: 'On Microsoft Foundry, a generally available model version is retired 18 months after launch, with at least 60 days’ notice, and standard deployments move to its replacement automatically. The date can’t be extended. Google keeps its long-term Gemini versions available for at least 12 months after release. Any workflow validated against one version, by a clinical reviewer, a model-risk team, or your own test set, has to be validated again when it goes. With weights you hold, the version changes when you decide.',
    fns: ['d', 'e'],
  },
  {
    num: '04',
    title: 'An air gap breaks every install script.',
    desc: 'Installing the open-source inference server vLLM pulls in 196 Python packages on Linux, 27 of them NVIDIA GPU libraries, before the model weights, the container image, or the GPU driver. Behind an air gap each one has to be mirrored, scanned, approved, and carried across by hand, and again at every update.',
    fns: ['f'],
  },
  {
    num: '05',
    title: 'The model has to fit the hardware you can buy.',
    desc: 'At 16-bit precision, a 70-billion-parameter model needs about 140 GB of GPU memory for its weights alone, more than a single 80 GB H100 holds, before the memory each request needs while it runs. Quantization and newer open models change that math: OpenAI says its open-weight gpt-oss-120b runs on a single 80 GB GPU. Sizing the model to the hardware is an engineering decision, and getting it wrong means buying hardware you didn’t need.',
    fns: ['g', 'h'],
  },
  {
    num: '06',
    title: 'The rules keep asking where the data is.',
    desc: 'DORA has required EU financial firms to manage concentration risk in their ICT providers since January 2025, and in November 2025 supervisors named AWS, Google Cloud, and Microsoft among 19 critical providers. NERC says its CIP standards effectively prohibit all but basic cloud use on the bulk power system, and its July 2026 draft would change that no earlier than 2029. India requires payment data to be stored in India, and its data-protection obligations take effect in May 2027. Each rule is different; together they mean an AI program has to document who holds its data, under which law, and in which country.',
    fns: ['i', 'j', 'k'],
  },
];

// Four deployment tiers, least to most isolated. `level` drives the four-segment isolation
// gauge, which is decorative: the "Tier n of 4" text and the list label carry the same information.
const TIERS: {
  level: number;
  name: string;
  desc: string;
  protects: string;
  tradeoff: string;
  fit: string;
  fns?: string[];
}[] = [
  {
    level: 1,
    name: 'Hosted API',
    desc: 'A frontier model behind an enterprise agreement: regional processing, no training on your data, short or zero retention.',
    protects: 'Long-term retention, and your data training someone else’s model.',
    tradeoff: 'The provider’s jurisdiction and its retirement schedule still apply.',
    fit: 'Most everyday work',
  },
  {
    level: 2,
    name: 'Sovereign cloud',
    desc: 'Single-tenant capacity in your region, in some markets run by a local operator under local law.',
    protects: 'Data leaving the region, and some foreign legal exposure when the operator is locally owned.',
    tradeoff: 'Still reachable over a network, and you still don’t hold the weights.',
    fit: 'In-region mandates',
  },
  {
    level: 3,
    name: 'Self-hosted',
    desc: 'Open-weight models on hardware you own or lease, inside your network, with outbound traffic blocked by default.',
    protects: 'Data leaving your network, forced model changes, and foreign legal process.',
    tradeoff: 'You run the GPUs, and the best open model still trails the best closed one.',
    fit: 'Sensitive data, validated workflows',
    fns: ['n'],
  },
  {
    level: 4,
    name: 'Air-gapped',
    desc: 'No network path in or out. Models, packages, and updates cross on approved media under a written procedure.',
    protects: 'Everything above, plus attacks that arrive over a network.',
    tradeoff: 'Every update is a procedure, so iteration is slower.',
    fit: 'Plant floors, isolated labs, trade secrets',
  },
];

// Why a healthcare-AI team belongs in this room. Left: evidenced capability. Right: where it lands.
const TRANSFERS: { have: string; apply: string; fns?: string[] }[] = [
  {
    have: 'Federated training across 71 sites on six continents, with no patient record moved',
    apply:
      'One model trained across countries, subsidiaries, or partners, with each dataset staying where the law keeps it.',
    fns: ['3'],
  },
  {
    have: 'Federated benchmarking: models scored on data the evaluator never sees',
    apply: 'Evaluation inside your perimeter, on your own test cases, before anyone relies on a model.',
  },
  {
    have: 'Inference optimization for constrained clinical hardware',
    apply: 'A capable model on the GPUs you can actually buy, power, and cool on-site.',
    fns: ['4', 'q'],
  },
  {
    have: 'Packages maintained on conda-forge for reproducible scientific computing',
    apply: 'Every dependency pinned, mirrored, and rebuildable on a network with no internet access.',
  },
  {
    have: 'Validation protocols and audit-ready documentation for clinical review',
    apply: 'A documentation package your security office can read before anything crosses the gap.',
  },
  {
    have: 'Low-code frameworks so non-ML staff can run the model',
    apply: 'Your team runs and updates it after we leave, and nothing in it calls home to us or anyone else.',
  },
];

// The six core services, in the nouns of a sovereign deployment. Nothing here is a new business line.
const SOVEREIGN_SERVICES: { num: string; title: string; desc: string; fns?: string[] }[] = [
  {
    num: '01',
    title: 'Readiness & architecture sprint',
    desc: 'Two to four weeks, fixed scope and fee: every candidate workload placed on a tier, hardware and models sized to it, and a build-vs-buy verdict per workload, including, wherever it is true, “a hosted API is fine for this one.”',
  },
  {
    num: '02',
    title: 'Data engineering inside the perimeter',
    desc: 'Ingestion, curation, and harmonization built where the data lives, plus the search indexes a private assistant reads from. No copy leaves the perimeter to make the work easier.',
  },
  {
    num: '03',
    title: 'Model selection, adaptation & evaluation',
    desc: 'Open-weight models shortlisted against your tasks and their license terms, fine-tuned on your data inside the perimeter, and scored by a harness built from your own test cases.',
  },
  {
    num: '04',
    title: 'Air-gapped deployment & MLOps',
    desc: 'Mirrored package and model registries, a written procedure for carrying updates across the gap, serving on your GPUs, and monitoring and drift detection that send nothing outside.',
  },
  {
    num: '05',
    title: 'Governance & documentation',
    desc: 'Data-flow maps, model and license records, validation protocols, and access-control design: the documents your security office, assessor, or regulator will ask for, written while the system is built.',
  },
  {
    num: '06',
    title: 'Fractional AI leadership',
    desc: 'Senior AI leadership a few days a month: vendor vetting (plenty of datasheets say “sovereign”; fewer products are), roadmap governance, and board reporting.',
  },
];

// Engagement models sized to how a sovereign AI program actually starts.
// Copy is length-tuned to ~3 lines of `desc` and ~2 lines of `outcome`; the card markup
// reserves exactly that height so every card aligns on the grid.
const SOVEREIGN_MODELS = [
  {
    title: 'Readiness sprint',
    desc: 'Two to four weeks, fixed scope and fee. You get a tier for every candidate workload, and the hardware, models, and budget each one implies.',
    outcome: 'A costed plan your security office has already read.',
  },
  {
    title: 'Private assistant pilot',
    desc: 'One team and one document collection, served by an open-weight model on your hardware and measured against how that team works today.',
    outcome: 'A visible win, and the offline stack underneath it.',
  },
  {
    title: 'Model fit & optimization',
    desc: 'The model works in the cloud but not on your hardware. We quantize, distill, and re-evaluate it until it fits the GPUs you have.',
    outcome: 'A model sized to your hardware, with the accuracy cost measured.',
  },
  {
    title: 'Offline MLOps build & handover',
    desc: 'Mirrors, registries, transfer procedure, serving, monitoring, and runbooks, built on your network and taught to the team that will run it.',
    outcome: 'An air-gapped stack your own team can update.',
  },
  {
    title: 'Cross-border federated program',
    desc: 'One model trained or evaluated across countries, subsidiaries, or partners, while every dataset stays in its own jurisdiction.',
    outcome: 'A shared model, and no raw data crossing a border.',
  },
  {
    title: 'Stalled-pilot rescue',
    desc: 'A private-AI pilot that impressed in the demo and stalled at security review. We close the findings and rebuild what can’t pass inside the perimeter.',
    outcome: 'The pilot back in front of the reviewers, with every finding answered.',
  },
];
---

<Base
  title="Air-Gapped & Sovereign AI"
  description="Vaiyu Solutions builds AI that runs entirely on infrastructure you control: open-weight models sized to your hardware, air-gapped deployment and MLOps, private assistants, and cross-border federated training, from a team that spent a decade building AI inside hospitals."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <WindField class="text-ink" />
    <div class="relative mx-auto grid max-w-6xl gap-12 px-5 pb-16 pt-20 md:pb-24 md:pt-28 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Eyebrow label="For air-gapped & sovereign deployments" class="reveal" />
        <h1 class="h-display mt-5 text-[2.6rem] md:text-6xl reveal reveal-2">
          Your data stays put. The model <em>comes to it</em>.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-soft reveal reveal-3">
          Most AI products assume they can reach the internet: to fetch weights and packages, check a
          license, or call a hosted model. On an air-gapped network none of that works, and a strict
          residency rule can forbid it. Vaiyu builds AI that runs entirely on infrastructure you
          control, with a written procedure for everything that crosses the gap, and tells you which
          workloads don’t need any of this. We learned how in hospitals, where patient data usually
          can’t leave the building.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 reveal reveal-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-3 bg-ink px-7 py-3.5 text-paper transition-colors hover:bg-saffron"
          >
            <span class="label-mono">Start a conversation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/work/" class="link-ink label-mono text-ink-soft">See the track record</a>
        </div>
      </div>
      <aside class="self-center lg:col-span-5 reveal reveal-5">
        <div class="border border-ink/15 bg-paper/80 p-7">
          <p class="label-mono text-slate">For workloads that can’t leave</p>
          <ul class="mt-4 divide-y divide-ink/10">
            {
              BRIDGE.map((b) => (
                <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3 sm:flex-nowrap">
                  <span class="w-full shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-widest text-slate sm:w-36">
                    {b.from}
                  </span>
                  <span aria-hidden="true" class="shrink-0 text-saffron">→</span>
                  <span class="font-display text-lg">{b.to}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- Proof bar -->
  <section aria-label="Track record" class="border-y border-ink/10 bg-cream">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-12 md:grid-cols-5">
      {
        STATS.map((s) => (
          <div>
            <p class="font-display text-4xl leading-none md:text-[2.6rem]">
              {s.prefix && (
                <span class="mr-1 align-middle font-mono text-[11px] uppercase tracking-widest text-slate">
                  {s.prefix}
                </span>
              )}
              {s.value}
              {s.fn && (
                <sup class="fn">
                  <a href={`#fn-${s.fn}`} aria-label={`Footnote ${s.fn}`}>
                    {s.fn}
                  </a>
                </sup>
              )}
            </p>
            <p class="mt-3 font-mono text-[11px] uppercase leading-relaxed tracking-[0.16em] text-slate">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The exposure -->
  <section class="relative border-t border-ink/10">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="01" label="The exposure" />
      <h2 class="h-display mt-4 max-w-3xl text-3xl md:text-4xl">
        Every default in the AI stack assumes your data can leave.
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        Hosted models, copilots, package registries, telemetry, and evaluation dashboards were built
        for organizations whose data can move. For a hospital, a bank, a drug-discovery lab, a grid
        operator, or a manufacturer, that assumption is where the exposure starts.
      </p>
      <ul class="mt-12 divide-y divide-ink/10 border-y border-ink/10">
        {
          EXPOSURE.map((b) => (
            <li class="group grid gap-x-8 gap-y-2 py-7 md:grid-cols-[4rem_1fr]">
              <span class="font-mono text-[11px] text-slate transition-colors group-hover:text-saffron">
                {b.num}
              </span>
              <div>
                <h3 class="font-display text-xl leading-snug transition-colors group-hover:text-saffron">
                  {b.title}
                </h3>
                <p class="mt-2.5 max-w-3xl leading-relaxed text-ink-soft">
                  {b.desc}
                  {b.fns && (
                    <sup class="fn">
                      {b.fns.map((f, i) => (
                        <Fragment>
                          {i > 0 && <span aria-hidden="true">,</span>}
                          <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                            {f}
                          </a>
                        </Fragment>
                      ))}
                    </sup>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The spectrum -->
  <section class="relative border-t border-ink/10 bg-cream">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="02" label="The spectrum" />
      <h2 class="h-display mt-4 max-w-3xl text-3xl md:text-4xl">
        <span class="inline-block">Sovereignty is a spectrum.</span>
        <span class="inline-block">An air gap is the far end of it.</span>
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        “Sovereign AI” is usually sold as one product. It works more like a scale: the European
        Commission now grades cloud providers from SEAL-0 to SEAL-4 in its own procurement.<sup
          class="fn"><a href="#fn-m" aria-label="Footnote m">m</a></sup
        > For AI workloads we use four tiers. Each protects against something the one before it does
        not, and each asks more of the team that runs it. In our work, most organizations need two: one
        for everyday work, and a stricter one for the few workloads that carry real risk.
      </p>
      <p class="label-mono mt-12 text-slate">Ordered by isolation, least to most</p>
      <ol class="mt-4 divide-y divide-ink/10 border-y border-ink/10">
        {
          TIERS.map((t) => (
            <li class="group grid gap-x-10 gap-y-4 py-7 md:grid-cols-[14rem_1fr] lg:grid-cols-[15rem_1fr_12rem]">
              <div>
                <p class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-slate">
                  <span>
                    Tier {t.level}
                    <span class="sr-only"> of 4</span>
                  </span>
                  <span aria-hidden="true" class="flex gap-1">
                    {[1, 2, 3, 4].map((n) => (
                      <span class:list={['block h-0.5 w-4', n <= t.level ? 'bg-ink/80' : 'bg-ink/15']} />
                    ))}
                  </span>
                </p>
                <h3 class="font-display mt-2.5 text-xl leading-snug transition-colors group-hover:text-saffron">
                  {t.name}
                </h3>
              </div>
              <div>
                <p class="max-w-2xl leading-relaxed text-ink-soft">{t.desc}</p>
                <dl class="mt-4 grid max-w-2xl gap-x-5 gap-y-2 text-sm leading-relaxed sm:grid-cols-[7.5rem_1fr]">
                  <dt class="font-mono text-[11px] uppercase leading-[1.625rem] tracking-[0.14em] text-slate sm:leading-[1.4rem]">
                    Guards against
                  </dt>
                  <dd class="text-ink-soft">{t.protects}</dd>
                  <dt class="mt-2 font-mono text-[11px] uppercase leading-[1.625rem] tracking-[0.14em] text-slate sm:mt-0 sm:leading-[1.4rem]">
                    Trade-off
                  </dt>
                  <dd class="text-ink-soft">
                    {t.tradeoff}
                    {t.fns && (
                      <sup class="fn">
                        {t.fns.map((f, i) => (
                          <Fragment>
                            {i > 0 && <span aria-hidden="true">,</span>}
                            <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                              {f}
                            </a>
                          </Fragment>
                        ))}
                      </sup>
                    )}
                  </dd>
                </dl>
              </div>
              <div class="md:col-start-2 lg:col-start-auto">
                <p class="label-mono text-slate">Right for</p>
                <p class="font-display mt-1.5 text-[0.95rem] italic leading-snug text-ink">{t.fit}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 max-w-2xl leading-relaxed text-ink-soft">
        The big clouds have moved too: AWS opened its European Sovereign Cloud in January 2026, Google
        sells Gemini on air-gapped hardware, and Microsoft offers disconnected editions of its
        stack.<sup class="fn"><a href="#fn-p" aria-label="Footnote p">p</a></sup> So you choose a tier
        per workload rather than per company. The expensive mistakes sit at the two ends:
        air-gapping work a hosted API would have handled well, and sending the one dataset that
        mattered to a hosted API.
      </p>
      <p class="mt-12 max-w-2xl border-l-2 border-saffron pl-6 font-display text-2xl italic leading-snug text-pretty md:text-[1.75rem]">
        We will tell you which tier each workload needs, including when the answer is the cloud.
      </p>
    </div>
  </section>

  <!-- What transfers -->
  <section class="relative border-t border-ink/10">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="03" label="What transfers" />
      <h2 class="h-display mt-4 max-w-2xl text-3xl md:text-4xl">
        We learned this in hospitals, where the data can’t leave either.
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        For a decade we have built AI for hospitals, where patient records stay on the hospital’s own
        network and regulators ask for evidence rather than a demo. Each row starts with work built for
        that setting and ends where it lands in yours.
      </p>
      <ul class="mt-12 divide-y divide-ink/10 border-y border-ink/10">
        {
          TRANSFERS.map((t) => (
            <li class="group grid items-baseline gap-x-10 gap-y-2 py-5 md:grid-cols-[1fr_auto_1fr]">
              <span class="leading-relaxed text-slate">
                {t.have}
                {t.fns && (
                  <sup class="fn">
                    {t.fns.map((f, i) => (
                      <Fragment>
                        {i > 0 && <span aria-hidden="true">,</span>}
                        <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                          {f}
                        </a>
                      </Fragment>
                    ))}
                  </sup>
                )}
              </span>
              <span
                aria-hidden="true"
                class="hidden shrink-0 text-saffron transition-transform group-hover:translate-x-0.5 md:block"
              >
                →
              </span>
              <span class="font-display text-lg leading-snug transition-colors group-hover:text-saffron">
                {t.apply}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-12 max-w-2xl border-l-2 border-saffron pl-6 font-display text-2xl italic leading-snug text-pretty md:text-[1.75rem]">
        Seventy-one sites on six continents trained one model, and no patient record left the site
        that held it.<sup class="fn"><a href="#fn-3" aria-label="Footnote 3">3</a></sup>
      </p>
    </div>
  </section>

  <!-- What we do for sovereign deployments -->
  <section class="relative border-t border-ink/10">
    <div class="relative mx-auto max-w-6xl px-5 py-16 md:py-20">
      <Eyebrow num="04" label="What we do for sovereign deployments" />
      <h2 class="h-display mt-4 max-w-2xl text-3xl md:text-4xl">
        Six services, run inside your perimeter.
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-ink-soft">
        We don’t sell GPUs, models, or a platform license. We design and build the system on hardware
        you own and models you are licensed to run, then hand it to the team that will operate it.
      </p>
      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          SOVEREIGN_SERVICES.map((s) => (
            <div class="group border-t-2 border-ink/80 pt-5 transition duration-200 hover:-translate-y-1 hover:border-saffron">
              <p class="font-mono text-[11px] text-slate transition-colors group-hover:text-saffron">{s.num}</p>
              <h3 class="font-display mt-3 text-xl transition-colors group-hover:text-saffron">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                {s.desc}
                {s.fns && (
                  <sup class="fn">
                    {s.fns.map((f, i) => (
                      <Fragment>
                        {i > 0 && <span aria-hidden="true">,</span>}
                        <a href={`#fn-${f}`} aria-label={`Footnote ${f}`}>
                          {f}
                        </a>
                      </Fragment>
                    ))}
                  </sup>
                )}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Credibility band -->
  <section class="relative overflow-hidden border-t-4 border-saffron bg-cream">
    <WindField class="text-ink" />
    <div class="relative mx-auto max-w-6xl px-5 py-20 md:py-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Eyebrow num="05" label="Credibility" />
          <h2 class="h-display mt-4 text-4xl md:text-5xl">
            Peer-reviewed, cited, and <em>standard-setting</em>.
          </h2>
          <p class="mt-6 max-w-xl leading-relaxed text-ink-soft">
            Our team’s research appears in <strong class="text-ink">Nature Communications</strong> and <strong class="text-ink">Nature Machine Intelligence</strong>, and has been covered
            by <strong class="text-ink">The Wall Street Journal</strong>. We’ve led more than <strong class="text-ink">$9M</strong> in NIH/NCI-funded R&D, and we hold the Vice Chair
            for Algorithmic Development of the <a href={SITE.mlcommons} class="link-ink" rel="noopener">MLCommons Medical Working Group</a>, helping write the standards medical AI is
            measured against.
          </p>
