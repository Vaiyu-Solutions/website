---
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
// Prefix match so nested pages (e.g. /announcements/<slug>/) still light up their section.
const isActive = (href: string) =>
  norm(path) === norm(href) || norm(path).startsWith(`${norm(href)}/`);
---

<header class="border-b border-ink/10 bg-paper">
  <div class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-6 px-5 py-5">
    <a href="/" class="logo-mark mr-auto block h-9 w-[178px] shrink-0">
      <span class="sr-only">Vaiyu Solutions, home</span>
    </a>
    <nav id="site-nav" aria-label="Main" class="order-last w-full md:order-none md:w-auto">
      <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
        {
          NAV.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
                class:list={[
                  'label-mono transition-colors hover:text-saffron',
                  isActive(l.href) ? 'text-saffron' : 'text-ink-soft',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      type="button"
      id="theme-toggle"
      class="theme-toggle -my-1 h-8 w-8 shrink-0 items-center justify-center self-center text-ink-soft transition-colors hover:text-saffron"
      aria-label="Switch to dark theme"
    >
      <svg
        class="on-light h-[1.05rem] w-[1.05rem]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"></path>
      </svg>
      <svg
        class="on-dark h-[1.05rem] w-[1.05rem]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
        ></path>
      </svg>
    </button>
    <button
      type="button"
      id="nav-trigger"
      class="nav-trigger -my-1 h-8 w-8 shrink-0 items-center justify-center self-center text-ink-soft transition-colors hover:text-saffron"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <svg
        class="h-[1.15rem] w-[1.15rem]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="nav-trigger-open" d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
        <path class="nav-trigger-close" d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path>
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    var meta = document.querySelector('meta[name="color-scheme"]');
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    if (!btn) return;

    function active() {
      if (root.classList.contains('theme-dark')) return 'dark';
      if (root.classList.contains('theme-light')) return 'light';
      return mq.matches ? 'dark' : 'light';
    }

    function label() {
      btn.setAttribute(
        'aria-label',
        active() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'
      );
    }

    btn.addEventListener('click', function () {
      var next = active() === 'dark' ? 'light' : 'dark';
      root.classList.remove('theme-light', 'theme-dark');
      root.classList.add('theme-' + next);
      if (meta) meta.content = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* Storage blocked: the choice holds for this page only. */
      }
      label();
    });

    // Only fires while the visitor is still following the system setting; the
    // palette itself is handled by CSS, this just keeps the button honest.
    mq.addEventListener('change', label);
    label();
  })();
</script>

<script is:inline>
  (function () {
    var trigger = document.getElementById('nav-trigger');
    var nav = document.getElementById('site-nav');
    if (!trigger || !nav) return;

    // Matches the `md` breakpoint the stylesheet collapses the nav at.
    var wide = window.matchMedia('(width >= 48rem)');

    function set(open) {
      nav.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    trigger.addEventListener('click', function () {
      set(trigger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        set(false);
        trigger.focus();
      }
    });

    // Past the breakpoint the links are visible again regardless of state, so
    // reset the trigger rather than leave it advertising a stale one.
    wide.addEventListener('change', function (e) {
      if (e.matches) set(false);
    });
  })();
</script>
