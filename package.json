{
  "name": "vaiyu-solutions-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new:post": "node scripts/new-post.mjs",
    "lint:firewall": "node scripts/firewall-lint.mjs",
    "verify": "astro build && node scripts/firewall-lint.mjs",
    "test:browser": "playwright test",
    "test:agent": "astro build && vitest run",
    "typecheck": "astro check",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.2",
    "@astrojs/sitemap": "^3.7.3",
    "@ui-sdk/core": "0.1.0-beta.10",
    "@ui-sdk/web": "0.1.0-beta.10",
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
